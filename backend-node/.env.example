# Local process configuration. Do not put provider secrets here.
# Production refuses to start without DATABASE_URL, APP_KEY and APP_URL.
PORT=8088
NODE_ENV=development
APP_URL=http://127.0.0.1:8088
# APP_KEY=
# DATABASE_URL=mysql://generosity:generosity@127.0.0.1:3306/generosity
# Comma-separated exact browser origins. Empty disables CORS.
# ALLOWED_ORIGINS=https://generosity.global
# Payments cannot be enabled from configuration.
