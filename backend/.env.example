APP_NAME=Generosity
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8088
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=generosity
DB_USERNAME=generosity
DB_PASSWORD=local-development-only
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=accounts@example.test
MAIL_FROM_NAME=Generosity
CORS_ALLOWED_ORIGINS=

# Only Generosity clients; no federation with other institute platforms.
GENEROSITY_PORTAL_URL="https://generosity.global/#acceso"
SANCTUM_STATEFUL_DOMAINS=generosity.global,www.generosity.global
# Set CORS_ALLOWED_ORIGINS=https://generosity.global,https://www.generosity.global in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Absolute path outside public_html to the Apple .p8 signing key.
APPLE_PRIVATE_KEY_PATH=
